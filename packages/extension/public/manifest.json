{
  "manifest_version": 3,
  "name": "Steplight",
  "version": "0.1.0",
  "description": "Record and flag every step an AI agent takes in your browser. Data stays on localhost.",
  "minimum_chrome_version": "110",
  "action": { "default_title": "Steplight", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:4777/*"],
  "optional_host_permissions": ["<all_urls>"]
}
